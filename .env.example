# Copy this file to .env and fill values locally. Never commit .env.
GMAIL_ADDRESS=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Optional; defaults to GMAIL_ADDRESS when blank or unset.
DIGEST_TO=
# Optional sources; leave blank unless enabled in config.yaml.
APIFY_TOKEN=
JOOBLE_API_KEY=
# Example only: reference this name from sources.recruitee.tenants[].token_env.
RECRUITEE_COMPANY_TOKEN=

# Scheduler defaults. Times use the selected IANA timezone.
JOB_ALERT_TIMEZONE=Africa/Lagos
JOB_ALERT_TIMES=07:07,19:07
RUN_ON_START=true
